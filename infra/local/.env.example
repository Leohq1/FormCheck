# Copy to infra/local/.env for Docker Compose (do not commit secrets).

POSTGRES_USER=formcheck
POSTGRES_PASSWORD=formcheck
POSTGRES_DB=formcheck

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=formcheck
MINIO_ROOT_PASSWORD=formchecksecret
MINIO_BUCKET=formcheck
# Browser-reachable MinIO endpoint used in presigned upload URLs
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Internal endpoint used by API/worker containers
MINIO_ENDPOINT=http://minio:9000

API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CAPABILITY_TOKEN_PEPPER=local-dev-pepper-change-me
RETENTION_HOURS=24
PIPELINE_VERSION=2026.10.0
FAKE_WORKER_STAGE_MS=400
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
