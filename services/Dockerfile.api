FROM python:3.12-slim

WORKDIR /app
COPY services/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY services/formcheck /app/formcheck
COPY packages/contracts /contracts

ENV PYTHONPATH=/app
ENV FORMCHECK_CONTRACTS_DIR=/contracts
EXPOSE 8000
CMD ["uvicorn", "formcheck.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
