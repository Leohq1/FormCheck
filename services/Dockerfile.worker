FROM python:3.12-slim

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libegl1 libgles2 \
    && rm -rf /var/lib/apt/lists/*
COPY services/requirements.txt /app/requirements.txt
COPY services/requirements-worker.txt /app/requirements-worker.txt
RUN pip install --no-cache-dir -r /app/requirements.txt -r /app/requirements-worker.txt
RUN pip uninstall -y opencv-contrib-python opencv-python || true
RUN pip install --no-cache-dir --force-reinstall "opencv-python-headless==5.0.0.93"

COPY services/formcheck /app/formcheck
COPY packages/contracts /contracts
COPY packages/rag/src/formcheck_rag /app/formcheck_rag
COPY packages/video/formcheck_video /app/formcheck_video
COPY packages/pose/formcheck_pose /app/formcheck_pose
COPY packages/biomechanics/formcheck_biomechanics /app/formcheck_biomechanics
COPY packages/rules/formcheck_rules /app/formcheck_rules
COPY services/worker/analysis/formcheck_analysis /app/formcheck_analysis
COPY corpus /app/corpus

ENV PYTHONPATH=/app
ENV FORMCHECK_CONTRACTS_DIR=/contracts
ENV FORMCHECK_CORPUS_MANIFEST=/app/corpus/manifests/sources.json
ENV FORMCHECK_START_SWEEPER=1
ENV MEDIAPIPE_POSE_MODEL_PATH=/models/pose_landmarker_full.task
CMD ["dramatiq", "formcheck.worker.tasks", "--processes", "1", "--threads", "2"]
