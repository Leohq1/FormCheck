{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-progress.schema.json",
  "title": "AnalysisProgress",
  "description": "Produced by the worker and consumed by Person 2 for status persistence and API polling.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "stage",
    "progress",
    "message_key",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "analysis_id": {
      "$ref": "common.schema.json#/$defs/analysisId"
    },
    "stage": {
      "type": "string",
      "enum": [
        "created",
        "uploading",
        "queued",
        "preprocessing",
        "pose_estimation",
        "phase_detection",
        "rule_evaluation",
        "retrieval",
        "generating",
        "completed",
        "inconclusive",
        "failed",
        "cancelled",
        "expired"
      ]
    },
    "progress": {
      "description": "Fraction in [0, 1], or null when the stage cannot report reliable progress.",
      "oneOf": [
        { "type": "null" },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ]
    },
    "message_key": {
      "type": ["string", "null"],
      "description": "Stable i18n / UI key for the current stage explanation."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO 8601 timestamp."
    }
  },
  "examples": [
    {
      "schema_version": "1",
      "analysis_id": "019a0000-0000-7000-8000-000000000001",
      "stage": "pose_estimation",
      "progress": null,
      "message_key": "estimating_pose",
      "updated_at": "2026-10-17T20:00:00Z"
    }
  ]
}
